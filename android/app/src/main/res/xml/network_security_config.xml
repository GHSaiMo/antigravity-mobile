<?xml version="1.0" encoding="utf-8"?>
<!-- Antigravity Mobile Android Network Security Configuration (H-1)
     SEC-AUDIT 2026-09-22 M-1: Allow cleartext HTTP for private LAN IP / loopback.
     Note: Android NSC <domain> element does NOT support numeric IP addresses or CIDR notation.
     Therefore base-config permits cleartext so local RFC1918 gateway connections (192.168.x.x, 10.x.x.x)
     can succeed, while external public cloud domains are explicitly forbidden cleartext here
     and enforced in OkHttp LanCleartextSecurityInterceptor. -->
<network-security-config>
    <!-- Base config: Permits LAN HTTP connection to Mac gateway on private IP / loopback -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Strictly forbid cleartext HTTP to external cloud services and public APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">day.app</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">cloudflare.com</domain>
        <domain includeSubdomains="true">jiuge.space</domain>
    </domain-config>
</network-security-config>
