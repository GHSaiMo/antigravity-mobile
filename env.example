# ==============================================================================
# Antigravity Mobile Gateway - 环境配置文件示例 (env.example)
# ==============================================================================
# 使用说明：
# 1. 复制本文件并重命名为 .env：
#    cp env.example .env
# 2. 按需微调下方端口、原生 APNs 推送或低额度预警阈值（默认开箱即用，无需手动配置）
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔔 iOS 原生 APNs 推送与灵动岛远程更新 (开箱即用，无需配置)
# ------------------------------------------------------------------------------
# App Store 正式版 / TestFlight 版 Multigravity 配对后会自动同步设备令牌并启用原生系统通知与灵动岛远程更新。
# 默认通过官方无状态 APNs 签名中继转发（不存储任何用户数据与聊天内容）；如需关闭或切换自建中继：
# APNS_ENABLED=1
# LIVE_ACTIVITY_PUSH_ENABLED=1
# APNS_RELAY_URL=https://push.jiuge.space
#
# 推送强脱敏模式（零客户端改动，同时生效于 APNs / 灵动岛 / FCM）：
# 设为 1 后将擦除全部会话标题、待审批命令原文、文件路径、问题正文与机器名，
# 仅向推送中继发送通知分类（如高危/普通审批）与纯数字步骤/进度比（如 3/5）。
# 兼容别名：MGY_PUSH_REDACT / PUSH_REDACT / APNS_REDACT
# MGY_PUSH_REDACT=0

# ------------------------------------------------------------------------------
# 📉 低额度预警（Gemini 5h，当前账号；通过原生 APNs / FCM 推送送达）
# ------------------------------------------------------------------------------
# 额度剩余 ≤ 提醒阈值时推一条普通通知，≤ 紧急阈值时再推一条时效性通知（带告警音，可穿透专注模式）。
# 每个重置周期每一档只推一次，网关重启不会重复推。正文附「按最近 60 分钟速度预计几点用完」（仅当早于重置时才写）。
# 关闭：QUOTA_ALERT_ENABLED=0；阈值为百分比整数，需满足 0 < 紧急 < 提醒 < 100，否则回退默认值。
# QUOTA_ALERT_ENABLED=1
# QUOTA_ALERT_WARN_PERCENT=20
# QUOTA_ALERT_CRITICAL_PERCENT=5

# ------------------------------------------------------------------------------
# 🤖 Android FCM 推送通知配置 (Android 专用，可选)
# ------------------------------------------------------------------------------
# 若您使用 Android 客户端并希望接收锁屏与通知栏远程推送：
# 1. 在 Firebase 控制台创建项目并获取 Server Key (或使用自建推送转发网关)
# 2. Android 客户端在连接网关后会自动上报 Device Token，也可手动配置静态 Token
# FCM_ENABLE=1
# FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here
# FCM_DEVICE_TOKEN=your_android_device_registration_token_here
# 自定义 FCM 推送端点（默认 https://fcm.googleapis.com/fcm/send）
# FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send

# ------------------------------------------------------------------------------
# 🌐 网关基础监听与网络配置 (可选)
# ------------------------------------------------------------------------------
# 网关监听端口，默认 58900
# MULTIGRAVITY_PORT=58900
# 绑定主机地址，留空绑定全部接口，也可指定 127.0.0.1 或内网物理 IP
# MULTIGRAVITY_HOST=

# ------------------------------------------------------------------------------
# 🔐 认证与安全配置
# ------------------------------------------------------------------------------
# 管理员特权密钥：用于跨网络管理设备（枚举设备、吊销设备、签发会话），请设置高强度随机字符串。
# 启用公网穿透隧道 / 非 loopback 监听时必须设置，且只能通过 Authorization: Bearer 传递（禁止 query）。
# MULTIGRAVITY_ADMIN_TOKEN=your_super_secret_admin_token_here

# 设备认证凭证持久化文件路径（默认 ~/.multigravity/auth_store.json）
# MULTIGRAVITY_AUTH_STORE_PATH=~/.multigravity/auth_store.json

# 是否完全禁用本地回环鉴权。仅当网关只监听 127.0.0.1 且未启用公网穿透时生效，否则进程拒绝启动。
# MULTIGRAVITY_AUTH_DISABLED=0

# 是否全面禁用 URL Query 参数传递令牌 (建议设为 1，强制仅允许 Bearer Header、HttpOnly Cookie 与一次性 WS Ticket)
# MULTIGRAVITY_DISABLE_QUERY_TOKEN=1

# ------------------------------------------------------------------------------
# ☁️ Cloudflare Tunnel 全自动公网穿透配置 (开箱即用)
# ------------------------------------------------------------------------------
# 网关默认已内置官方调度器并自动启用。启动时会自动下载 cloudflared 并注册专属永久 HTTPS 子域名。
# 若搭建了自己的 Worker 调度器，可在此填入自定义 Worker 地址进行覆盖：
# CF_WORKER_URL=https://dispatcher.jiuge.space
# 若 Worker 配置了专属暗号，在此填入；留空则全公开无感注册：
# CF_INVITE_CODE=
# 手动覆盖已有的专属 Tunnel Token (可选，设置后直接复用不再向 Worker 申请)：
# CF_TUNNEL_TOKEN=
# 是否显式关闭 Cloudflare 穿透（设为 0 或 false 则仅监听本地与局域网）：
# CF_TUNNEL_ENABLED=1

# ------------------------------------------------------------------------------
# 🛡️ 零知识 E2EE 高级隐私加固与自托管中继 (BYO-Relay，可选)
# ------------------------------------------------------------------------------
# 1. 纯原生 App 隐私模式：设为 1 后在中继通道上关闭静态 Web/PWA 页面放行，并隐藏 /healthz 中的静态公钥 e2ee_pub
# MGY_RELAY_DISABLE_WEB=0
#
# 2. 自有 CDN / Nginx / Caddy 反向代理强制 E2EE：设为 1 后所有外部/反代流量均必须走 E2EE 加密通道（本机 CLI 与局域网直连不受影响）
# MGY_FORCE_E2EE=0
#
# 3. 严格防重放模式：设为 1 后拒绝未携带时间戳与 req_id 的旧版客户端 E2EE 请求（确认所有 App 升级后可开启）
# MGY_E2EE_STRICT_REPLAY=0
#
# 4. 一键自托管私有中继（BYO-Relay）：通过 `mgy-relay token --domain dev.example.com` 离线签发 Token 后配置如下三项，
#    网关将完全脱离官方调度器与 cloudflared，直连您的私有 mgy-relay 节点：
# MGY_CUSTOM_RELAY_ENDPOINT=wss://relay.example.com/_mgy_tunnel
# MGY_CUSTOM_RELAY_TOKEN=mgyr1....
# MGY_CUSTOM_RELAY_PUBLIC_URL=https://dev.example.com

# ------------------------------------------------------------------------------
# 🧩 多机聚合网关 Hub / Node 配置 (mgy hub / mgy node，可选，详见 docs/hub_guide.md)
# ------------------------------------------------------------------------------
# 普通 mgy 默认开启被动局域网发现（仅回应局域网 Hub 探针，需 6 位二次确认码方可接入）；
# 设为 1 可彻底关闭局域网 UDP 发现与被动应答（等价启动参数 -no-discovery）：
# MGY_DISABLE_DISCOVERY=0
# 局域网 UDP 发现端口（默认 58901）
# MGY_HUB_DISCOVERY_PORT=58901
# Hub 无头模式（不依赖本机 Antigravity 实例，适合 NAS / 常驻小主机）
# MGY_HUB_HEADLESS=0
# Hub 或节点显示名称（会话与项目自动标注为 [名称] 前缀）
# MGY_HUB_NAME=
# MGY_NODE_NAME=
# 集群共享密钥（仅用于同密钥 mgy node 免密自动发现加入，明文密钥不走网络）
# MGY_HUB_SECRET=
# 逗号分隔静态节点列表，如 M1=http://192.168.50.12:58900,M2=http://192.168.50.13:58900
# MGY_HUB_NODES=
# mgy node 目标 Hub 地址与 6 位加入码
# MGY_HUB_URL=
# MGY_HUB_CODE=
# mgy node 默认关闭自身公网穿透隧道；设为 1 允许该节点同时保留独立公网隧道供单独手机直连
# MGY_NODE_ENABLE_TUNNEL=0

# ------------------------------------------------------------------------------
# 🧪 Cockpit 与高级调试配置 (可选)
# ------------------------------------------------------------------------------
# Cockpit 配额数据目录覆盖（默认自动检测本地 Antigravity 数据目录）
# COCKPIT_DATA_DIR=/path/to/custom/cockpit/data


# 日志级别 (debug|info|warn|error) 与格式 (text|json)
# MULTIGRAVITY_LOG_LEVEL=info
# MULTIGRAVITY_LOG_FORMAT=text

# 启动时是否异步检查新版本（每 12 小时最多检查一次，设为 0 可关闭）
# MULTIGRAVITY_UPDATE_CHECK=1
