# ==============================================================================
# Antigravity Mobile Gateway - 环境配置文件示例 (env.example)
# ==============================================================================
# 使用说明：
# 1. 复制本文件并重命名为 .env：
#    cp env.example .env
# 2. 在下方填写你的 Bark 推送地址（填入后网关会自动开启 iOS 通知推送功能）
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔔 iOS Bark 实时推送通知配置
# ------------------------------------------------------------------------------
# 【如何下载 Bark App】:
#   - 在 iPhone / iPad 的 App Store 搜索「Bark」
#   - 官方应用名: 「Bark - 给你的手机发推送」 (开发者: Feng Wu / 伍峰，开源作者 Finb)
#   - App Store 链接: https://apps.apple.com/cn/app/bark-%E7%BB%99%E4%BD%A0%E7%9A%84%E6%89%8B%E6%9C%BA%E5%8F%91%E6%8E%A8%E9%80%81/id1403753865
#   - 注意避坑: 请认准纯色极简图标，不要下载成带有小狗图标的国外儿童监控软件 "Bark - Parental Controls"
#
# 【如何获取与复制专属链接】:
#   1. 在 iPhone 上安装并打开 Bark App；
#   2. 首页顶部会自动生成你设备的专属服务器链接（形式如: https://api.day.app/YOUR_DEVICE_KEY/）；
#   3. 点击链接卡片或右上角复制图标，即可将完整链接或 Device Key 复制到剪贴板。
#
# 【开启说明】:
#   - 只要在下方 BARK_URL 填入复制的链接（或 Device Key），网关启动时就会自动启用实时通知！
#   - 若留空或注释掉此项，通知功能将自动保持静默关闭。
# ------------------------------------------------------------------------------
BARK_URL=https://api.day.app/YOUR_DEVICE_KEY/

# 【Antigravity 推送图标】
# 默认指向本项目开源仓库的 Antigravity 官方矢量高清图标。
# Bark 收到推送时会自动拉取此图标渲染在 iPhone 锁屏与通知栏（需 iOS 15+）。
BARK_ICON=https://raw.githubusercontent.com/GHSaiMo/antigravity-mobile/main/web/icons/icon-192.png

# 【通知分组名称】
# 在 iOS 通知中心将所有来自反重力 Agent 的提醒自动归类折叠为一组，避免多条消息霸屏。
BARK_GROUP=Antigravity

# 【需要审批 / Action 时的提示音】
# 常用提示音可选: alarm (警报长音), anticipation, bell, horn, multiwayinvitation
BARK_SOUND_ACTION=alarm

# 【任务全部执行完成时的提示音】
# 常用提示音可选: glass (清脆短促), paymentsuccess, success, chime
BARK_SOUND_COMPLETE=glass

# 【Bark 推送超时秒数】（单次 HTTP 请求超时，默认 10 秒）
# BARK_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 🤖 Android FCM 推送通知配置 (Android 专用，可选)
# ------------------------------------------------------------------------------
# 若您使用 Android 客户端并希望接收锁屏与通知栏远程推送：
# 1. 在 Firebase 控制台创建项目并获取 Server Key (或使用自建推送转发网关)
# 2. Android 客户端在连接网关后会自动上报 Device Token，也可手动配置静态 Token
# FCM_ENABLE=1
# FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here
# FCM_DEVICE_TOKEN=your_android_device_registration_token_here
# 自定义 FCM 推送端点（默认 https://fcm.googleapis.com/fcm/send）
# FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send

# ------------------------------------------------------------------------------
# 🌐 网关基础监听与网络配置 (可选)
# ------------------------------------------------------------------------------
# 网关监听端口，默认 58900
# MULTIGRAVITY_PORT=58900
# 绑定主机地址，留空绑定全部接口，也可指定 127.0.0.1 或内网物理 IP
# MULTIGRAVITY_HOST=

# ------------------------------------------------------------------------------
# 🔐 认证与安全配置
# ------------------------------------------------------------------------------
# 管理员特权密钥：用于跨网络管理设备（枚举设备、吊销设备、签发会话），请设置高强度随机字符串。
# 启用 FRP / 非 loopback 监听时必须设置，且只能通过 Authorization: Bearer 传递（禁止 query）。
# MULTIGRAVITY_ADMIN_TOKEN=your_super_secret_admin_token_here

# 设备认证凭证持久化文件路径（默认 ~/.multigravity/auth_store.json）
# MULTIGRAVITY_AUTH_STORE_PATH=~/.multigravity/auth_store.json

# 是否完全禁用本地回环鉴权。仅当网关只监听 127.0.0.1 且未启用 FRP 时生效，否则进程拒绝启动。
# MULTIGRAVITY_AUTH_DISABLED=0

# ------------------------------------------------------------------------------
# ☁️ Cloudflare Tunnel 全自动公网穿透配置 (开箱即用)
# ------------------------------------------------------------------------------
# 网关默认已内置官方调度器并自动启用。启动时会自动下载 cloudflared 并注册专属永久 HTTPS 子域名。
# 若搭建了自己的 Worker 调度器，可在此填入自定义 Worker 地址进行覆盖：
# CF_WORKER_URL=https://dispatcher.jiuge.space
# 若 Worker 配置了专属暗号，在此填入；留空则全公开无感注册：
# CF_INVITE_CODE=
# 手动覆盖已有的专属 Tunnel Token (可选，设置后直接复用不再向 Worker 申请)：
# CF_TUNNEL_TOKEN=
# 是否显式关闭 Cloudflare 穿透（设为 0 或 false 则仅监听本地与局域网）：
# CF_TUNNEL_ENABLED=1

# ------------------------------------------------------------------------------
# 🧪 Cockpit 与高级调试配置 (可选)
# ------------------------------------------------------------------------------
# Cockpit 配额数据目录覆盖（默认自动检测本地 Antigravity 数据目录）
# COCKPIT_DATA_DIR=/path/to/custom/cockpit/data

