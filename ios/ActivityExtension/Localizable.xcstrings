    "在主屏幕与 CarPlay 随时查看待确认、运行中的 Agent 任务，轻点直达对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor pending approvals and running Agent tasks on Home Screen and CarPlay, and jump straight into any chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面やCarPlayで承認待ち・実行中のAgentタスクを確認し、タップで直接会話へ移動できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕与 CarPlay 随时查看待确认、运行中的 Agent 任务，轻点直达对话。"
          }
        }
      }
    },
    "在锁屏、主屏幕、iPad 与 CarPlay 查看 5 小时与 7 天额度余量、重置倒计时与活跃对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track 5h & 7d quota balance, reset countdowns, and active chats across Lock Screen, Home Screen, iPad, and CarPlay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面・ホーム画面・iPad・CarPlayで5時間/7日間のクォータ残量、リセット時刻、アクティブ会話を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏、主屏幕、iPad 与 CarPlay 查看 5 小时与 7 天额度余量、重置倒计时与活跃对话。"
          }
        }
      }
    },
    "在锁屏、主屏幕与 CarPlay 随时查看 5 小时与 7 天额度余量及重置倒计时。": {
      "localizations": {
        "en": {
