    "从本地 Multigravity 网关拉取最新 5 小时与 7 天额度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch the latest 5h and 7d quota from your local Multigravity gateway."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのMultigravityゲートウェイから最新の5h/7d枠を取得します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地 Multigravity 网关拉取最新 5 小时与 7 天额度。"
          }
        }
      }
    },
    "从本地 Multigravity 网关拉取最新活跃对话与 Agent 状态。": {
