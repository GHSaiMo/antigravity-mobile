        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination folder already exists. Choose another location or folder name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同名のフォルダがすでに存在します。別の場所かフォルダ名を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标目录已存在，请更换位置或修改文件夹名"
          }
        }
      }
    },
    "直接发送": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Immediately"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま送信"
          }
        }
      }
    },
    "直接向蜂群协作板发送人类反馈，协调各成员或给出方向指令（发送至协调者）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send feedback directly to the Swarm board (routed to Coordinator)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swarm ボードへ直接フィードバックを送り、方針を指示します（コーディネーター宛てに送信）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接向蜂群协作板发送人类反馈，协调各成员或给出方向指令（发送至协调者）。"
          }
        }
      }
    },
    "直接导入到 Antigravity 项目列表": {
      "localizations": {
