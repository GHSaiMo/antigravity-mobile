    "将恢复为系统初始的 4 个模板，当前自定义模板、快捷菜单配置和排序会被替换。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the 4 default templates and replaces your custom templates and quick-menu order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期の4つのテンプレートに戻します。現在のカスタムテンプレート、クイックメニュー設定、並び順は置き換えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将恢复为系统初始的 4 个模板，当前自定义模板、快捷菜单配置和排序会被替换。"
          }
        }
      }
    },
    "将把此前自动或批量翻译的会话标题恢复为原始标题（手动重命名的会话不受影响）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore titles previously translated by AI Assist back to their original text (manually renamed titles are preserved)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動・一括翻訳された会話タイトルを元の英語タイトルに戻します（手動変更したタイトルは維持されます）。"
          }
        }
      }
    },
    "将提交 %lld 个文件的改动并推送到分支 %@ 的远程仓库。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit %#@files@ and push to remote branch %2$@."
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg file"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg files"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のファイル変更をコミットし、リモートブランチ %@ にプッシュします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提交 %lld 个文件的改动并推送到分支 %@ 的远程仓库。"
          }
        }
      }
    },
    "将检索与命令步骤收起为单行摘要": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize tool calls into a single line"
