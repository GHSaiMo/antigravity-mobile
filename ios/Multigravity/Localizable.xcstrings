    "近 %lld 步均未命中缓存（累计重算 %@），可能正在加速消耗周额度，建议压缩或开启新会话。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@misses@ (%2$@ uncached input) may drain weekly quota faster. Consider compacting or starting a new session."
          },
          "substitutions": {
            "misses": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg cache miss"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg consecutive cache misses"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 %lld ステップ連続でキャッシュ未命中（再計算 %@）。週間クォータを急消費する恐れがあります。圧縮または新規チャットをおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 %lld 步均未命中缓存（累计重算 %@），可能正在加速消耗周额度，建议压缩或开启新会话。"
          }
        }
      }
    },
