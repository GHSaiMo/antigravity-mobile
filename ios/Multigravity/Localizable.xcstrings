    "/workflow 请使用 run_workflow 动态编排工作流，以 parallel 并发对 [模块/文件路径] 进行多维度审计（安全/性能/类型规范），并在最终阶段输出结构化修复建议。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow Use run_workflow to run a parallel multi-angle audit (security, performance, types) on [module/path] and summarize structured fix recommendations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow run_workflow を使ってワークフローを動的に編成し、[モジュール/ファイルパス] に対して parallel で多角的な監査（セキュリティ・性能・型安全性）を並列実行し、構造化された修正提案をまとめてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow 请使用 run_workflow 动态编排工作流，以 parallel 并发对 [模块/文件路径] 进行多维度审计（安全/性能/类型规范），并在最终阶段输出结构化修复建议。"
          }
        }
      }
    },
    "/workflow 请使用 run_workflow 编写 Python 动态工作流脚本，分阶段执行以下任务：[描述具体任务]，要求使用 parallel 并发加速并给出 finish 契约结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow Use run_workflow to orchestrate a staged Python workflow for [task description], using parallel execution where helpful and reporting the final contract."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow run_workflow を使って Python の動的ワークフローを作成し、[タスク内容] を段階的に実行してください。可能な箇所は parallel で並列化し、最終的な finish 結果を報告してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow 请使用 run_workflow 编写 Python 动态工作流脚本，分阶段执行以下任务：[描述具体任务]，要求使用 parallel 并发加速并给出 finish 契约结果。"
          }
        }
      }
    },
    "/workflow 请使用 run_workflow 编排自动化单测，以 parallel 同时运行 [测试目标或路径] 的单元测试，聚合失败信息并生成修复方案。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow Use run_workflow to run unit tests for [target or path] in parallel, aggregate failures, and propose targeted fixes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow run_workflow を使って自動テストを編成し、[テスト対象またはパス] のユニットテストを parallel で並列実行し、失敗箇所を集約して修正案を提示してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/workflow 请使用 run_workflow 编排自动化单测，以 parallel 同时运行 [测试目标或路径] 的单元测试，聚合失败信息并生成修复方案。"
          }
        }
      }
    },
    "/workflow 请使用 run_workflow 编排调研工作流，分派子代理分别调查 [调研主题] 的核心技术方案、竞品对比与最佳实践，并汇总为结构化报告。": {
