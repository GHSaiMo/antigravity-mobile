    "相机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机"
          }
        }
      }
    },
    "相机仅用于扫描配对二维码；本地网络仅用于发现与连接局域网/VPN 网关；麦克风与语音识别仅用于语音输入；相册仅用于选取附件或保存图片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera is used only to scan pairing QR codes; Local Network discovers LAN/VPN gateways; Microphone and Speech Recognition power voice input; Photos is used only for selecting attachments or saving images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラはペアリングQRコードのスキャンのみに使用し、ローカルネットワークはLAN/VPNゲートウェイの検出・接続に、マイクと音声認識は音声入力に、写真は添付ファイルの選択や画像保存のみに使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机仅用于扫描配对二维码；本地网络仅用于发现与连接局域网/VPN 网关；麦克风与语音识别仅用于语音输入；相册仅用于选取附件或保存图片。"
          }
        }
      }
    },
    "相机已被设备策略限制": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Restricted by Device Policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスポリシーによりカメラが制限されています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机已被设备策略限制"
          }
        }
      }
    },
    "短按建议胶囊可将其填入输入框方便修改；长按 1.5 秒待进度条走满后直接发送，提前松手即可取消防误触。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a suggestion pill to fill the input box for editing; hold for 1.5 seconds until the progress bar completes to send directly, or release early to cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案カプセルを短押しすると入力欄に挿入されます。1.5 秒間長押ししてプログレスバーが満タンになるとそのまま送信され、途中で離すとキャンセルされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按建议胶囊可将其填入输入框方便修改；长按 1.5 秒待进度条走满后直接发送，提前松手即可取消防误触。"
          }
        }
      }
    },
    "短按开始实时语音对话，按住说话可进行流式听写": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap for live voice conversation, or press and hold for streaming dictation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでリアルタイム音声通話、長押しでストリーミング音声入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按开始实时语音对话，按住说话可进行流式听写"
          }
        }
      }
    },
    "短按打开工具与任务看板，长按切换全局权限模式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open Tools & Tasks board; long-press to switch global permission mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでツール＆タスクボードを開く、長押しでグローバル権限モードを切替"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按打开工具与任务看板，长按切换全局权限模式"
          }
        }
      }
    },
    "短按打开满屏提示词模板库；长按上滑可极速将高频工程模板填入输入框。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to open the full prompt template library; hold and slide up to insert frequent templates instantly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでテンプレート一覧を開き、長押しして上にスライドすると頻出テンプレートを素早く入力欄へ挿入できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按打开满屏提示词模板库；长按上滑可极速将高频工程模板填入输入框。"
          }
        }
      }
    },
    "短按模型胶囊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Model Chip"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルカプセルをタップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
