    "**检查电脑麦克风**：系统麦克风权限已开启，默认录音设备正常且未被占用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Check computer microphone**: System microphone permission is granted and the default input device is active and available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**PCのマイクを確認**：システムのマイク権限が許可されており、既定の入力デバイスが正常に動作しているか確認してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**检查电脑麦克风**：系统麦克风权限已开启，默认录音设备正常且未被占用"
          }
        }
      }
    },
    "**检查网络与代理**：确保 `*.googleapis.com` 长连接（HTTP/2、gRPC）未被拦截（使用代理时请开启 TUN 模式）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Check network & firewall**: Ensure persistent HTTP/2 and gRPC connections to `*.googleapis.com` aren't blocked by a VPN, firewall, or proxy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ネットワークとファイアウォールを確認**：`*.googleapis.com` への HTTP/2・gRPC 常時接続が VPN・ファイアウォール・プロキシで遮断されていないか確認してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**检查网络与代理**：确保 `*.googleapis.com` 长连接（HTTP/2、gRPC）未被拦截（使用代理时请开启 TUN 模式）"
          }
        }
      }
    },
