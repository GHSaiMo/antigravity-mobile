    "确定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定"
          }
        }
      }
    },
    "确定丢弃该文件改动？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard changes to this file?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの変更を破棄しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定丢弃该文件改动？"
          }
        }
      }
    },
    "确定删除此会话吗？\n此操作将永久删除会话记录且无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this conversation?\nThis permanently deletes the conversation and cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話を削除しますか？\n会話履歴は完全に削除され、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定删除此会话吗？\n此操作将永久删除会话记录且无法撤销。"
          }
        }
      }
    },
    "确定删除此草稿会话吗？\n此操作将删除本地临时会话且无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this draft conversation?\nThis removes the local draft and cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この下書き会話を削除しますか？\nローカルの一時会話は削除され、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定删除此草稿会话吗？\n此操作将删除本地临时会话且无法撤销。"
          }
        }
      }
    },
    "确定取消归档此会话吗？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unarchive this conversation?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のアーカイブを解除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定取消归档此会话吗？"
          }
        }
      }
    },
    "确定取消置顶此会话吗？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin this conversation?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のピン留めを解除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定取消置顶此会话吗？"
          }
        }
      }
    },
    "确定归档此会话吗？\n归档后该会话将移入「已归档」，随时可查看或恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive this conversation?\nArchived conversations are moved to Archived and can be restored anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話をアーカイブしますか？\nアーカイブした会話は「アーカイブ済み」に移動し、いつでも復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定归档此会话吗？\n归档后该会话将移入「已归档」，随时可查看或恢复。"
          }
        }
      }
    },
    "确定清空本地缓存？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Local Cache?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルキャッシュを消去しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定清空本地缓存？"
          }
        }
      }
    },
    "确定移除「%@」吗？将通知该网关解绑此设备并清除该主机的本地缓存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove \"%@\"? This will unpair your device from the gateway and clear local caches for this host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？ゲートウェイ側の端末紐付けを解除し、このホストのローカルキャッシュを消去します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定移除「%@」吗？将通知该网关解绑此设备并清除该主机的本地缓存。"
          }
        }
      }
    },
    "确定置顶此会话吗？\n置顶后该会话将固定显示在会话列表顶部。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin this conversation?\nPinned conversations stay at the top of the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話をピン留めしますか？\nピン留めした会話は一覧の上部に固定されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定置顶此会话吗？\n置顶后该会话将固定显示在会话列表顶部。"
          }
        }
      }
    },
    "确定要删除「%@」吗？这会同时删除电脑端对应的规则或记忆文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%@\"? This will also remove the corresponding rule or memory file on your computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？PC上の対応するルールまたはメモリファイルも削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除「%@」吗？这会同时删除电脑端对应的规则或记忆文件。"
          }
        }
      }
    },
    "确定要删除定时任务「%@」吗？删除后将停止调度并移除该任务配置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete automation \"%@\"? Its schedule will stop and its configuration will be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期タスク「%@」を削除しますか？スケジュールが停止され、設定も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除定时任务「%@」吗？删除后将停止调度并移除该任务配置。"
          }
        }
      }
    },
    "确定要撤回到该消息吗？": {
