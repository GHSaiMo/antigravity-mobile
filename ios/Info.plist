<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Multigravity</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Multigravity</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Files</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.ghsaimo.antigravity</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>multigravity</string>
				<string>antigravity</string>
				<string>agy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Multigravity uses the camera to scan pairing QR codes and capture photos to send to your agent.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Multigravity uses the microphone for voice messages and real-time voice conversations with your agent.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Multigravity uses the local network to connect directly to your computer's local gateway and sync conversations.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Multigravity saves exported conversation images and charts to your Photo Library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Multigravity accesses your Photo Library so you can attach and send images in conversations.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>square.and.pencil</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New Chat</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ghsaimo.antigravity.shortcut.new-chat</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>folder.badge.plus</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New Workspace Chat</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ghsaimo.antigravity.shortcut.new-workspace</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>camera</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Take Photo</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ghsaimo.antigravity.shortcut.camera</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>doc.viewfinder</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Scan Document</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ghsaimo.antigravity.shortcut.scan</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
